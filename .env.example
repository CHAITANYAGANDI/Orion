# Copy to .env and fill in. Defaults let the whole stack run WITHOUT any real keys
# (auth in dev mode, AI in mock mode). Add real keys to enable full features.

# ---- Auth ----
# dev  = accept X-Dev-User header (no Clerk needed)
# clerk = validate real Clerk JWTs (requires CLERK_ISSUER + CLERK_JWKS_URL)
REVERIE_AUTH_MODE=dev
NEXT_PUBLIC_AUTH_MODE=dev
CLERK_ISSUER=
CLERK_JWKS_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Shared secret for FastAPI -> Spring internal callbacks
REVERIE_INTERNAL_TOKEN=dev-internal-token

# ---- AI provider (summaries, extraction, RAG) ----
# mock   = deterministic fake transcript/summary (no key, great for demos/tests)
# openai = real Whisper + GPT
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna

# ---- Transcription provider (chosen separately from AI_PROVIDER) ----
# auto       = follow AI_PROVIDER (default; what every earlier setup expects)
# mock       = scripted transcript, no key
# openai     = Whisper. Accurate, but does NOT diarize — every speaker is "S1".
# assemblyai = real speaker separation ("Speaker 1", "Speaker 2", …)
#
# assemblyai for speech + mock for analysis is a useful combination: it
# exercises the real audio path and real diarization while costing nothing for
# the LLM.
TRANSCRIPTION_PROVIDER=auto

# assemblyai is the choice for meetings: strong speaker-attributed accuracy and
# no 25MB chunking, so speaker identity holds across a long recording rather
# than restarting partway through.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-3-5-pro
# `speech_models` is a priority list: this is routed to when the detected
# language is not supported by the model above. Blank disables the fallback.
ASSEMBLYAI_FALLBACK_MODEL=universal-2
# Blank = auto-detect the language. Set an ISO code (e.g. es) when every
# meeting is in one language; detection is good but a wrong guess is costly.
ASSEMBLYAI_LANGUAGE=

# --- Neon (Postgres) -------------------------------------------------------
# BOTH URLs use the DIRECT endpoint (the host WITHOUT `-pooler`).
#
# The runtime, because row-level security is armed with a session-level setting
# on each connection and a transaction-mode pooler gives the next transaction a
# different server connection -- which comes back as an account with nothing in
# it rather than as an error. Hikari is already this process's connection pool.
#
# Flyway, because it holds an advisory lock across several transactions and a
# transaction-mode pooler does not keep one.
#
# The runtime uses the unprivileged role so row-level security binds; Flyway
# uses the schema owner.
# Strip `channel_binding` from the JDBC URLs -- the driver rejects it.
SPRING_DATASOURCE_URL=
APP_DB_USER=reverie_app
APP_DB_PASSWORD=
SYS_DB_USER=reverie_sys
SYS_DB_PASSWORD=
FLYWAY_URL=
FLYWAY_USER=
FLYWAY_PASSWORD=
# The ai-service speaks libpq, so it takes the parts rather than a URL.
PG_HOST=
PG_PORT=5432
PG_DATABASE=neondb
PG_SSLMODE=require

# --- Cloudflare R2 (object storage) ----------------------------------------
# Required: there is no local MinIO any more. The endpoint is
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com -- account id from the R2
# dashboard sidebar. Keys come from "Manage R2 API Tokens" -> Create API Token
# with "Object Read & Write" scoped to the bucket; the *Access Key ID* and
# *Secret Access Key*, NOT the Cloudflare API "Token value".
#
# PUBLIC and internal endpoints are the same host, unlike MinIO: R2 answers
# from the internet, so AssemblyAI can fetch a recording from a presigned URL
# instead of the bytes crossing the ai-service twice.
#
# Do not make the bucket public. Everything is served by presigned URL; an
# unsigned GET against a private bucket returns 400, which is the point.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=reverie
S3_REGION=auto

# --- Email (Resend) ---------------------------------------------------------
# Optional, and off until BOTH of the first two are set. That default is not a
# convenience: a deployment that sends from a domain it does not own gets the
# domain classified as spam, and unlike most misconfigurations that one is not
# undone by fixing the setting.
#
# RESEND_API_KEY comes from resend.com -> API Keys, with "Sending access".
# REVERIE_MAIL_FROM must be on a domain verified in Resend -- an unverified
# sender is rejected at the API, not silently dropped, so a wrong value here
# shows up in the log rather than in nobody's inbox.
#
# Seven messages use this and five of them are off per account until somebody
# switches them on in Settings -> Email notifications. See V64__account_email.sql.
#
# IN PRODUCTION BOTH ARE REQUIRED. DeploymentCheck refuses to start without
# them, because two of the seven have no switch -- an account closed and its
# data deleted, and an allowance spent -- and the first is the only record of an
# irreversible act that exists once the account is gone. Development is
# unaffected: the check runs only under the `production` profile, and a laptop
# with no key queues nothing it cannot deliver.
#
# REVERIE_MAIL_FROM must be on a domain verified in Resend. onboarding@resend.dev
# is refused: it works, which is the trap, and it delivers only to the Resend
# account owner -- so every account-closure notice would go to you rather than
# to the person whose account it was.
RESEND_API_KEY=
REVERIE_MAIL_FROM=Reverie <notifications@send.reverieai.in>
# Where a reply goes, if anywhere. Left blank, replies bounce -- which is
# honest for a no-reply sender and wrong for one that invites a reply, so the
# account-closed message deliberately does not ask for one.
REVERIE_MAIL_REPLY_TO=
# "This deployment has no users other than me."
#
# Without a verified domain Resend sends only from onboarding@resend.dev, which
# delivers to the Resend account owner and nobody else. That is wrong for a
# product and correct for a deployment whose only account is yours -- so rather
# than making the production check impossible to satisfy, say which of the two
# you are. Warned about on every boot; unset it before anybody else signs up.
REVERIE_MAIL_SELF_ONLY=
# Required whenever the above is true. Your Clerk user id -- the JWT subject,
# which is what provisioning is keyed on. It starts with `user_` and is on your
# user in the Clerk dashboard.
#
# This is what makes self-only enforceable rather than trusted: every other
# subject is refused at provisioning, so no account is created for it. Hiding
# the sign-up button would not do -- Clerk creates the account whatever Reverie's
# UI shows, and the token it mints is real.
REVERIE_MAIL_SELF_USER_ID=
# Below this many seconds, a finished recording is not worth an email: it
# finished before the reader left the page. Fifteen minutes.
REVERIE_MAIL_NOTES_MIN_SECONDS=900
