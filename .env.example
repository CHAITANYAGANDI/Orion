# Copy to .env and fill in. Defaults let the whole stack run WITHOUT any real keys
# (auth in dev mode, AI in mock mode). Add real keys to enable full features.

# ---- Auth ----
# dev  = accept X-Dev-User header (no Clerk needed)
# clerk = validate real Clerk JWTs (requires CLERK_ISSUER + CLERK_JWKS_URL)
ORION_AUTH_MODE=dev
NEXT_PUBLIC_AUTH_MODE=dev
CLERK_ISSUER=
CLERK_JWKS_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Shared secret for FastAPI -> Spring internal callbacks
ORION_INTERNAL_TOKEN=dev-internal-token

# ---- AI provider (summaries, extraction, RAG) ----
# mock   = deterministic fake transcript/summary (no key, great for demos/tests)
# openai = real Whisper + GPT
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna

# ---- Transcription provider (chosen separately from AI_PROVIDER) ----
# auto       = follow AI_PROVIDER (default; what every earlier setup expects)
# mock       = scripted transcript, no key
# openai     = Whisper. Accurate, but does NOT diarize — every speaker is "S1".
# assemblyai = real speaker separation ("Speaker 1", "Speaker 2", …)
#
# assemblyai for speech + mock for analysis is a useful combination: it
# exercises the real audio path and real diarization while costing nothing for
# the LLM.
TRANSCRIPTION_PROVIDER=auto

# assemblyai is the choice for meetings: strong speaker-attributed accuracy and
# no 25MB chunking, so speaker identity holds across a long recording rather
# than restarting partway through.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-3-5-pro
# `speech_models` is a priority list: this is routed to when the detected
# language is not supported by the model above. Blank disables the fallback.
ASSEMBLYAI_FALLBACK_MODEL=universal-2
# Blank = auto-detect the language. Set an ISO code (e.g. es) when every
# meeting is in one language; detection is good but a wrong guess is costly.
ASSEMBLYAI_LANGUAGE=

# --- Neon (Postgres) -------------------------------------------------------
# Runtime uses the POOLED endpoint and the unprivileged role so row-level
# security binds. Flyway uses the DIRECT endpoint (the same host with
# `-pooler` removed) and the schema owner, because it holds an advisory lock
# across several transactions and a transaction-mode pooler does not keep one.
# Strip `channel_binding` from the JDBC URLs -- the driver rejects it.
SPRING_DATASOURCE_URL=
APP_DB_USER=orion_app
APP_DB_PASSWORD=
SYS_DB_USER=orion_sys
SYS_DB_PASSWORD=
FLYWAY_URL=
FLYWAY_USER=
FLYWAY_PASSWORD=
# The ai-service speaks libpq, so it takes the parts rather than a URL.
PG_HOST=
PG_PORT=5432
PG_DATABASE=neondb
PG_SSLMODE=require

# --- Cloudflare R2 (object storage) ----------------------------------------
# Required: there is no local MinIO any more. The endpoint is
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com -- account id from the R2
# dashboard sidebar. Keys come from "Manage R2 API Tokens" -> Create API Token
# with "Object Read & Write" scoped to the bucket; the *Access Key ID* and
# *Secret Access Key*, NOT the Cloudflare API "Token value".
#
# PUBLIC and internal endpoints are the same host, unlike MinIO: R2 answers
# from the internet, so AssemblyAI can fetch a recording from a presigned URL
# instead of the bytes crossing the ai-service twice.
#
# Do not make the bucket public. Everything is served by presigned URL; an
# unsigned GET against a private bucket returns 400, which is the point.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=orion
S3_REGION=auto
