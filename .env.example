# Copy to .env and fill in. Defaults let the whole stack run WITHOUT any real keys
# (auth in dev mode, AI in mock mode). Add real keys to enable full features.

# ---- Auth ----
# dev  = accept X-Dev-User header (no Clerk needed)
# clerk = validate real Clerk JWTs (requires CLERK_ISSUER + CLERK_JWKS_URL)
RECALLIX_AUTH_MODE=dev
NEXT_PUBLIC_AUTH_MODE=dev
CLERK_ISSUER=
CLERK_JWKS_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Shared secret for FastAPI -> Spring internal callbacks
RECALLIX_INTERNAL_TOKEN=dev-internal-token

# ---- AI provider (summaries, extraction, RAG) ----
# mock   = deterministic fake transcript/summary (no key, great for demos/tests)
# openai = real Whisper + GPT
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- Transcription provider (chosen separately from AI_PROVIDER) ----
# auto     = follow AI_PROVIDER (default; what every earlier setup expects)
# mock     = scripted transcript, no key
# openai   = Whisper. Accurate, but does NOT diarize — every speaker is "S1".
# deepgram = real speaker separation ("Speaker 1", "Speaker 2", …)
#
# Deepgram for speech + mock for analysis is a useful combination: it exercises
# the real audio path and real diarization while costing nothing for the LLM.
TRANSCRIPTION_PROVIDER=auto
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Blank = auto-detect the language. Set an ISO code (e.g. es) when every
# meeting is in one language; detection is good but a wrong guess is costly.
DEEPGRAM_LANGUAGE=

# ---- Stripe (optional; billing UI works, checkout needs keys) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
